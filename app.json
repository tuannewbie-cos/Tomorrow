{
  "expo": {
    "name": "Tomorrow",
    "slug": "soulmate-genz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#131314"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soulmate.genz"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131314"
      },
      "package": "com.soulmate.genz"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Tomorrow truy cập thư viện ảnh để cùng chia sẻ hình ảnh với bạn."
        }
      ],
      "expo-asset"
    ]
  }
}
